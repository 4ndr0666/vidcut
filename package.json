{
  "name": "vidcut",
  "version": "2.7.0",
  "description": "Fast, lossless video cutter, merger, converter and screen recorder",
  "author": {
    "name": "4ndr0666",
    "email": "01_dolorloftier@icloud.com"
  },
  "repository": "github:4ndr0666/vidcut",
  "copyright": "Copyright (c) 2024-2026",
  "license": "MIT",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node scripts/test-cut.js",
    "test:server": "node scripts/test-server.js",
    "smoke": "electron scripts/electron-smoke.js",
    "visual": "electron scripts/visual-check.js",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "build:linux": "electron-builder -l",
    "build:win": "electron-builder -w"
  },
  "build": {
    "appId": "io.github.4ndr0666.vidcut",
    "files": [
      "app/**/*",
      "!app/bin/*.exe",
      "LICENSE",
      "README.md"
    ],
    "asarUnpack": [
      "app/bin/**"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb"
      ],
      "category": "Video"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "asar": true
      },
      "makers": [
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "linux"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.1",
    "@electron-forge/maker-zip": "^7.6.1",
    "@electron-forge/plugin-auto-unpack-natives": "^7.6.1",
    "@electron-forge/plugin-fuses": "^7.6.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "debug": "4.4.3",
    "once": "1.4.0",
    "@types/node": "24.12.4"
  }
}
